# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-random-secret-key

# Database
DATABASE_URI=sqlite:///instance/wastewise.db

# Model Configuration
MODEL_DIR=../models
UPLOAD_DIR=uploads

# Upload Limits
MAX_UPLOAD_SIZE=16777216  # 16 MB in bytes

# Logging
LOG_LEVEL=DEBUG
